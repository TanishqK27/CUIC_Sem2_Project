\@writefile{toc}{\contentsline {section}{\numberline {10.1}Understanding Execution Costs}{45}{section.10.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {10.2}Slippage Estimates by Order Size}{45}{section.10.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10.1}{\ignorespaces Estimated slippage by order size. The left panel shows total slippage (spread plus market impact) as a percentage of order value. Slippage increases modestly for orders under \$500 but accelerates sharply above \$1,000. The right panel decomposes slippage into spread cost (roughly constant percentage) and market impact (increasing with size). The horizontal dashed line indicates the median spread cost of 1.15\% (half-spread).}}{46}{figure.caption.32}\protected@file@percent }
\newlabel{fig:slippage}{{10.1}{46}{Estimated slippage by order size. The left panel shows total slippage (spread plus market impact) as a percentage of order value. Slippage increases modestly for orders under \$500 but accelerates sharply above \$1,000. The right panel decomposes slippage into spread cost (roughly constant percentage) and market impact (increasing with size). The horizontal dashed line indicates the median spread cost of 1.15\% (half-spread)}{figure.caption.32}{}}
