\newlabel{sec:nba-specific}{{8}{36}{NBA-Specific Phenomena}{chapter.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.1}Game Momentum Effects}{36}{section.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.1}{\ignorespaces Price response to scoring momentum. The left panel shows average probability shift following momentum events (8+ unanswered points), varying by game phase and pre-momentum probability. Momentum in the third quarter with even game states (50\% probability) generates the largest shifts (15--20 percentage points). The right panel shows how quickly prices adjust, with most adjustment occurring within 90 seconds of the final basket in the run.}}{36}{figure.caption.25}\protected@file@percent }
\newlabel{fig:momentum}{{8.1}{36}{Price response to scoring momentum. The left panel shows average probability shift following momentum events (8+ unanswered points), varying by game phase and pre-momentum probability. Momentum in the third quarter with even game states (50\% probability) generates the largest shifts (15--20 percentage points). The right panel shows how quickly prices adjust, with most adjustment occurring within 90 seconds of the final basket in the run}{figure.caption.25}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.2}Blowout Dynamics}{37}{section.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.2}{\ignorespaces Blowout game dynamics showing the relationship between outcome probability and market quality. As probability exceeds 90\%, depth begins declining sharply. At 95\%+ probability, depth drops by approximately 80\% and spreads widen to 5--8\%. The ``point of no return'' where liquidity effectively vanishes occurs at approximately 97--98\% probability.}}{37}{figure.caption.26}\protected@file@percent }
\newlabel{fig:blowout}{{8.2}{37}{Blowout game dynamics showing the relationship between outcome probability and market quality. As probability exceeds 90\%, depth begins declining sharply. At 95\%+ probability, depth drops by approximately 80\% and spreads widen to 5--8\%. The ``point of no return'' where liquidity effectively vanishes occurs at approximately 97--98\% probability}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.3}Comeback Dynamics}{38}{section.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.3}{\ignorespaces Comeback game dynamics showing sustained high volatility throughout the game. Unlike blowouts where volatility collapses, comeback games maintain elevated uncertainty. The price path shows multiple lead changes, with spreads narrowing near 50\% probability (peak uncertainty) and widening at extremes.}}{38}{figure.caption.27}\protected@file@percent }
\newlabel{fig:comeback-dynamics}{{8.3}{38}{Comeback game dynamics showing sustained high volatility throughout the game. Unlike blowouts where volatility collapses, comeback games maintain elevated uncertainty. The price path shows multiple lead changes, with spreads narrowing near 50\% probability (peak uncertainty) and widening at extremes}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8.4}Pre-Game Information Shocks}{38}{section.8.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {8.4}{\ignorespaces Price discovery speed following information events. The chart shows cumulative price adjustment over time after news arrival. Approximately 70\% of the total price adjustment occurs within the first 2 minutes, and 90\% within 5 minutes. This rapid incorporation suggests efficient information processing, though brief windows exist for traders with faster information access.}}{39}{figure.caption.28}\protected@file@percent }
\newlabel{fig:price-discovery}{{8.4}{39}{Price discovery speed following information events. The chart shows cumulative price adjustment over time after news arrival. Approximately 70\% of the total price adjustment occurs within the first 2 minutes, and 90\% within 5 minutes. This rapid incorporation suggests efficient information processing, though brief windows exist for traders with faster information access}{figure.caption.28}{}}
\@writefile{lot}{\contentsline {table}{\numberline {8.1}{\ignorespaces Pre-Game Information Event Impacts}}{39}{table.caption.29}\protected@file@percent }
