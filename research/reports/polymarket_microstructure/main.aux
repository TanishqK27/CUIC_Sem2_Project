\@writefile{toc}{\contentsline {section}{\numberline {5.1}Understanding Trade Flow}{23}{section.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {5.2}Trade Size Distribution}{23}{section.5.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.1}{\ignorespaces Distribution of trade sizes on logarithmic scale. The left panel shows the frequency distribution with a median of \$21.52 (95\% CI: \$20--\$23). The right panel shows the cumulative volume distribution, revealing that trades above \$1,000 (1.3\% of trades) account for 57.5\% of total volume. This whale dominance characterizes the market's volume dynamics.}}{24}{figure.caption.15}\protected@file@percent }
\newlabel{fig:trade-sizes}{{5.1}{24}{Distribution of trade sizes on logarithmic scale. The left panel shows the frequency distribution with a median of \$21.52 (95\% CI: \$20--\$23). The right panel shows the cumulative volume distribution, revealing that trades above \$1,000 (1.3\% of trades) account for 57.5\% of total volume. This whale dominance characterizes the market's volume dynamics}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {section}{\numberline {5.3}Whale Analysis}{24}{section.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.1}{\ignorespaces Trade Size Category Analysis}}{24}{table.caption.16}\protected@file@percent }
