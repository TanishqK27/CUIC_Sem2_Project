\@writefile{toc}{\contentsline {section}{\numberline {11.1}Case Study Selection}{50}{section.11.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {11.1}{\ignorespaces Case Study Selection Criteria}}{50}{table.caption.36}\protected@file@percent }
