# =============================================================================
# CUIC Quant Fund - Environment Variables Template
# =============================================================================
#
# Copy this file to .env in the project root:
#   cp configs/example.env .env
#
# Then fill in your API keys and configuration.
#
# IMPORTANT: Never commit .env to git! It's already in .gitignore.
#

# -----------------------------------------------------------------------------
# The Odds API
# Get your free API key at: https://the-odds-api.com/
# Free tier: 500 requests/month
# -----------------------------------------------------------------------------
ODDS_API_KEY=

# -----------------------------------------------------------------------------
# Kalshi
# Create account and get credentials at: https://kalshi.com/
# Use demo environment for testing
# -----------------------------------------------------------------------------
KALSHI_EMAIL=
KALSHI_PASSWORD=

# API URL - use demo for testing, production for real trading
# Demo (recommended for development):
KALSHI_API_URL=https://demo-api.kalshi.co/trade-api/v2
# Production (real money - use with caution):
# KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2

# -----------------------------------------------------------------------------
# Polymarket (Optional - for trading only)
# Most endpoints are public and don't require authentication
# Get API keys from Polymarket settings if you want to trade
# Note: Not available to US residents
# -----------------------------------------------------------------------------
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_WALLET_ADDRESS=

# -----------------------------------------------------------------------------
# Database (CockroachDB - shared team database)
# Get connection string from: https://cockroachlabs.cloud
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://username:PASSWORD@hostname:26257/defaultdb?sslmode=verify-full

# -----------------------------------------------------------------------------
# General Settings
# -----------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data cache directory (relative to project root)
CACHE_DIR=data/cache

# Request timeout in seconds
REQUEST_TIMEOUT=30

# -----------------------------------------------------------------------------
# Development Settings
# -----------------------------------------------------------------------------

# Enable debug mode (more verbose logging)
DEBUG=false

# Jupyter notebook token (leave empty for no auth in local dev)
JUPYTER_TOKEN=
