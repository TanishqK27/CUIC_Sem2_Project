# =============================================================================
# CUIC Quant Fund - Git Ignore Rules
# =============================================================================

# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# Translations
*.mo
*.pot

# Scrapy stuff
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
.pybuilder/
target/

# pyenv
.python-version

# pipenv
Pipfile.lock

# poetry
poetry.lock

# pdm
.pdm.lock
.pdm-python
.pdm-build/
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# pytype static type analyzer
.pytype/

# Cython debug symbols
cython_debug/

# =============================================================================
# Virtual Environments
# =============================================================================
.venv/
venv/
ENV/
env/
.env.local
.venv.bak/
venv.bak/

# =============================================================================
# Jupyter Notebooks
# =============================================================================
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# IPython
profile_default/
ipython_config.py

# Jupyter Notebook auto-saves
*.ipynb.autosave

# =============================================================================
# IDE / Editors
# =============================================================================

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.vsix

# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-workspace
*.sublime-project

# Vim
*.swp
*.swo
*~
.netrwhist

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp
.\#*

# =============================================================================
# Environment & Secrets
# =============================================================================

# Environment files (NEVER commit secrets!)
.env
.env.*
!.env.example
!.env.template
*.env
!configs/example.env

# API keys
api_keys.json
secrets.json
credentials.json
*.pem
*.key

# =============================================================================
# Data Files
# =============================================================================

# Raw data (too large for git)
data/raw/*
!data/raw/.gitkeep

# Processed data
data/processed/*
!data/processed/.gitkeep

# External data
data/external/*
!data/external/.gitkeep

# Cache
data/cache/

# Large files
*.csv
*.parquet
*.pkl
*.pickle
*.h5
*.hdf5
*.feather

# Exceptions: allow example/small data files
!**/examples/*.csv
!**/fixtures/*.csv
!data/dummy_backtest_input.csv
!data/dummy_backtest_output.csv
!data/test_games.csv

# =============================================================================
# OS Generated Files
# =============================================================================

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon

# macOS Finder
.fseventsd
.VolumeIcon.icns

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# =============================================================================
# Logs & Temporary Files
# =============================================================================
*.log
logs/
*.tmp
*.temp
*.bak
*.backup

# =============================================================================
# Model Artifacts
# =============================================================================
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.onnx
!models/.gitkeep

